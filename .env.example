# Copy to .env. Process environment overrides this file; CLI flags win.
# Local Kokoro is the default, even when OPENAI_API_KEY is set.
COTORRA_PROVIDER=kokoro
API_BASE_URL=http://10.17.17.99:9084/v1
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_heart
# Set to the API_KEY used when launching Kokoro, if authentication is enabled.
KOKORO_API_KEY=

# Only used with --provider openai (or COTORRA_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Optional CLI/server defaults.
COTORRA_PLAYER=auto
COTORRA_STREAM=auto
COTORRA_LISTEN=127.0.0.1:8099
# Separate credential protecting Cotorra's own HTTP server, not the backend.
# Required for non-loopback listening. Keep it different from backend keys.
COTORRA_SERVER_API_KEY=
# COTORRA_INSTRUCTIONS=Speak clearly and naturally.
